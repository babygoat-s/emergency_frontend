# Local Vite development and preview proxy (HTTP + WebSocket).
API_PROXY_TARGET=http://127.0.0.1:8000

# Vercel frontend build: HTTPS origin of the authenticated API.
# Set this on the frontend project. Only the origin is exposed in the browser bundle.
# BE_API_BASE_URL=https://api.example.com
#
# Public client ID for Sign in with Google. Use the same client ID on the API.
# GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com

# Optional override for a separately deployed frontend.
# Leave empty to use /api on the current origin. Never add API keys here.
# VITE_API_BASE_URL=https://your-api.example.com
